<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FootballManagementDemo.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageBackground}"
    Title="Football Management">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <VerticalStackLayout Spacing="4">
                <Label Text="FOOTBALL MANAGEMENT"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryGreen}" />
                <Label Text="Server-agnostic API demo"
                       FontSize="30"
                       FontAttributes="Bold" />
                <Label Text="The same C# game engine is being called directly from a .NET MAUI client."
                       FontSize="15"
                       TextColor="{StaticResource MutedText}" />
            </VerticalStackLayout>

            <Border BackgroundColor="{StaticResource CardBackground}"
                    StrokeShape="RoundRectangle 16"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="1. Select your club"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Picker x:Name="TeamPicker"
                            Title="Choose a team"
                            ItemDisplayBinding="{Binding DisplayName}" />
                    <Button Text="Manage this team"
                            Clicked="OnSelectTeamClicked"
                            BackgroundColor="{StaticResource PrimaryGreen}"
                            TextColor="White"
                            CornerRadius="10" />
                    <Label x:Name="SelectionStatus"
                           Text="No club selected."
                           FontSize="14"
                           TextColor="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0"
                        BackgroundColor="{StaticResource CardBackground}"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="SEASON" FontSize="12" TextColor="{StaticResource MutedText}" />
                        <Label x:Name="SeasonLabel" Text="2026" FontSize="24" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource CardBackground}"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="FIXTURES" FontSize="12" TextColor="{StaticResource MutedText}" />
                        <Label x:Name="FixtureCountLabel" Text="0" FontSize="24" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border BackgroundColor="{StaticResource CardBackground}"
                    StrokeShape="RoundRectangle 16"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="2. API call demonstration"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label Text="GET /api/game"
                           FontAttributes="Bold" />
                    <Editor x:Name="ApiOutput"
                            HeightRequest="150"
                            IsReadOnly="True"
                            AutoSize="TextChanges"
                            FontFamily="Courier New"
                            FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource CardBackground}"
                    StrokeShape="RoundRectangle 16"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="3. Game engine"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label x:Name="NextFixtureLabel"
                           Text="No fixture selected."
                           FontSize="15" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Advance one week"
                                Clicked="OnAdvanceWeekClicked"
                                CornerRadius="10" />
                        <Button Grid.Column="1"
                                Text="Simulate next match"
                                Clicked="OnSimulateClicked"
                                CornerRadius="10" />
                    </Grid>
                    <Label x:Name="EngineStatus"
                           FontSize="14"
                           TextColor="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Runs on Android, iOS, Mac Catalyst and Windows."
                   HorizontalOptions="Center"
                   FontSize="13"
                   TextColor="{StaticResource MutedText}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
